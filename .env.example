# =============================================================================
# Captive Portal - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Portal (container: portal)
# -----------------------------------------------------------------------------
# Public domain for redirect URLs (e.g. your-vps-ip.nip.io or your-domain.com)
PORTAL_DOMAIN=167.71.229.249.nip.io

# Hostname used by portal to reach the server (default: server, for Docker)
# SERVER_HOST=server

# -----------------------------------------------------------------------------
# Firebase / Firestore (container: server)
# -----------------------------------------------------------------------------
# Service account for Firestore. Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key from the JSON key file. For Docker, replace newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Twilio SMS (container: server)
# -----------------------------------------------------------------------------
# Required for scheduling/sending SMS. From https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Messaging Service SID (starts with MG). Required for scheduled messages.
# Create at: https://console.twilio.com/us1/develop/sms/services
# Optional for immediate sends if TWILIO_PHONE_NUMBER is set.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback for immediate sends when Messaging Service is not set.
# E.164 format, e.g. +14155551234
# TWILIO_PHONE_NUMBER=+14155551234

# -----------------------------------------------------------------------------
# Twilio Webhook Signature Validation (container: server)
# -----------------------------------------------------------------------------
# Public URL of this server — used to validate Twilio webhook signatures
# e.g. https://your-server.example.com:4000 (no trailing slash)
SERVER_PUBLIC_URL=http://167.71.229.249.nip.io:4000

# -----------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) (container: server)
# -----------------------------------------------------------------------------
# Phone Number ID — from Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Permanent System User access token — from Meta Business Settings > System Users
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# Webhook verify token — any string you choose; must match what you enter in
# Meta App > WhatsApp > Configuration > Webhook > Verify Token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# -----------------------------------------------------------------------------
# RADIUS (if used)
# -----------------------------------------------------------------------------
# RADIUS_SECRET=your_radius_secret

# -----------------------------------------------------------------------------
# Router Offline Alerts (container: server)
# -----------------------------------------------------------------------------
# Secret key used to authenticate AP heartbeat calls to POST /ap-heartbeat
# Generate any strong random string, e.g.: openssl rand -hex 32
# Must be set for heartbeat endpoint to accept requests (fails closed if unset)
AP_HEARTBEAT_SECRET=your_ap_heartbeat_secret

# URL of the CMS dashboard — included in offline alert emails as a "View Dashboard" link
CMS_DASHBOARD_URL=https://cms.heidifi.ai

# Brevo — required for offline/recovery emails (shared with marketing emails)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=HeidiFi

# -----------------------------------------------------------------------------
# Internal API (container: server)
# -----------------------------------------------------------------------------
# Shared secret for server-to-server calls from the CMS to POST /internal/test-send
# (immediate marketing test sends). Generate any strong random string:
#   openssl rand -hex 32
# Must match the CMS's CAPTIVE_SERVER_INTERNAL_SECRET. Endpoint fails closed if unset.
# See docs/marketing-test-send.md
INTERNAL_API_SECRET=your_internal_api_secret

# -----------------------------------------------------------------------------
# MCP server (container: mcp) — captive-server/mcp/
# -----------------------------------------------------------------------------
# Exposes HeidiFi captive-portal data to AI tools (Claude Code, Cursor) over the
# Model Context Protocol with Notion-style multi-tenant OAuth 2.1. Deployed as its
# own service at mcp.heidifi.ai:4001. See mcp/README / docs.
#
# Canonical MCP resource URI (RFC 8707 audience). No trailing slash.
MCP_SERVER_URL=https://mcp.heidifi.ai/mcp
# Authorization Server issuer origin (same as the resource server in v1).
MCP_ISSUER_URL=https://mcp.heidifi.ai
# Portal consent screen that /oauth/authorize redirects the user to.
OAUTH_CONSENT_URL=https://portal.heidifi.ai/captive-oauth/consent
# Token lifetimes.
OAUTH_CODE_TTL_SECONDS=120
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# DEV ONLY (never set in production): bypass OAuth with a static token bound to one tenant.
# MCP_DEV_STATIC_TOKEN=
# MCP_DEV_TENANT_ID=

