# =============================================================================
# Captive Portal - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Portal (container: portal)
# -----------------------------------------------------------------------------
# Public domain for redirect URLs (e.g. your-vps-ip.nip.io or your-domain.com)
PORTAL_DOMAIN=167.71.229.249.nip.io

# Hostname used by portal to reach the server (default: server, for Docker)
# SERVER_HOST=server

# -----------------------------------------------------------------------------
# Firebase / Firestore (container: server)
# -----------------------------------------------------------------------------
# Service account for Firestore. Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key from the JSON key file. For Docker, replace newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Twilio SMS (container: server)
# -----------------------------------------------------------------------------
# Required for scheduling/sending SMS. From https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Messaging Service SID (starts with MG). Required for scheduled messages.
# Create at: https://console.twilio.com/us1/develop/sms/services
# Optional for immediate sends if TWILIO_PHONE_NUMBER is set.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback for immediate sends when Messaging Service is not set.
# E.164 format, e.g. +14155551234
# TWILIO_PHONE_NUMBER=+14155551234

# -----------------------------------------------------------------------------
# Twilio Webhook Signature Validation (container: server)
# -----------------------------------------------------------------------------
# Public URL of this server — used to validate Twilio webhook signatures
# e.g. https://your-server.example.com:4000 (no trailing slash)
SERVER_PUBLIC_URL=http://167.71.229.249.nip.io:4000

# -----------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) (container: server)
# -----------------------------------------------------------------------------
# Phone Number ID — from Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Permanent System User access token — from Meta Business Settings > System Users
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# Webhook verify token — any string you choose; must match what you enter in
# Meta App > WhatsApp > Configuration > Webhook > Verify Token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# -----------------------------------------------------------------------------
# RADIUS (if used)
# -----------------------------------------------------------------------------
# RADIUS_SECRET=your_radius_secret

# -----------------------------------------------------------------------------
# Router Offline Alerts (container: server)
# -----------------------------------------------------------------------------
# Secret key used to authenticate AP heartbeat calls to POST /ap-heartbeat
# Generate any strong random string, e.g.: openssl rand -hex 32
# Must be set for heartbeat endpoint to accept requests (fails closed if unset)
AP_HEARTBEAT_SECRET=your_ap_heartbeat_secret

# URL of the CMS dashboard — included in offline alert emails as a "View Dashboard" link
CMS_DASHBOARD_URL=https://portal.heidifi.ai

# Brevo — required for offline/recovery emails (shared with marketing emails)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=HeidiFi

# Secret used to HMAC-sign per-recipient marketing unsubscribe links (GET/POST /u/:token).
# Must be set for unsubscribe links to be generated (links resolve to empty if unset).
# Generate any strong random string, e.g.: openssl rand -hex 32
UNSUBSCRIBE_SIGNING_SECRET=your_unsubscribe_signing_secret

# -----------------------------------------------------------------------------
# Guest verification / OTP (containers: server, portal)
# -----------------------------------------------------------------------------
# Signs the proof-of-verification token that /verify/check mints and every
# network-granting path requires. WITHOUT THIS, verification silently does not
# happen: resolveVerification() disables it and guests connect unverified (loudly
# logged at boot). Deliberately does NOT fall back to any other secret — an empty
# HMAC key would be forgeable by anyone who can read this repo.
#   openssl rand -hex 32
# Needed by BOTH the server and the portal containers: the portal validates the
# token locally on the Aruba /submit path to avoid a round trip on the critical
# path to getting online.
GUEST_VERIFICATION_SIGNING_SECRET=your_guest_verification_signing_secret

# Peppers the one-time codes hashed at rest in CaptivePortal_GuestVerifications.
# Rotating it invalidates every code in flight (max 10 minutes of impact).
#   openssl rand -hex 32
GUEST_OTP_PEPPER=your_guest_otp_pepper

# Lets the server trust the X-Forwarded-For the portal sets on proxied guest
# requests. Without it every guest arrives with the portal container's IP, so the
# per-IP OTP rate limits are SKIPPED (per-destination and per-AP still apply).
# Port 4000 is published on the host, so the header is only honoured when this
# secret matches — otherwise the limit could be bypassed with a forged header.
# Must be identical in the server and portal containers.
#   openssl rand -hex 32
PORTAL_SHARED_SECRET=your_portal_shared_secret

# Per-venue ceiling on verification codes sent per UTC day — the real defence
# against SMS pumping on a public unauthenticated endpoint. On breach the venue
# WAIVES verification rather than blocking wifi (guests connect, but are never
# marked verified). Default 500 when unset.
GUEST_OTP_DAILY_CAP_PER_VENUE=500

# -----------------------------------------------------------------------------
# Internal API (container: server)
# -----------------------------------------------------------------------------
# Shared secret for server-to-server calls from the CMS to POST /internal/test-send
# (immediate marketing test sends). Generate any strong random string:
#   openssl rand -hex 32
# Must match the CMS's CAPTIVE_SERVER_INTERNAL_SECRET. Endpoint fails closed if unset.
# See docs/marketing-test-send.md
INTERNAL_API_SECRET=your_internal_api_secret

# -----------------------------------------------------------------------------
# UniFi controller (container: server)
# -----------------------------------------------------------------------------
# Credentials for the shared UniFi Network Application. Used for guest authorization,
# venue WLAN orchestration, and the 5-minute pending-device adoption sweep.
#
# The URL here MUST be the INTERNAL Docker address, not the public one the CMS uses:
# this container shares a network with the controller and cannot NAT-hairpin to the
# host's public IP. UNIFI_CONTROLLER_URL always overrides whatever is stored on an AP.
#
# Username/password were historically "fallback only" (each AP doc carries a snapshot
# stamped at creation), but resolveAnyController now prefers these — per-AP snapshots go
# stale on rotation, and enough credential-less AP docs would starve the adoption sweep.
# Treat them as REQUIRED. See docs/unifi-setup.md and docs/unifi-multi-tenancy-decision.md.
UNIFI_CONTROLLER_URL=https://unifi:8443
UNIFI_SITE=default
UNIFI_USERNAME=captive-service
UNIFI_PASSWORD=your_unifi_service_password

# Optional. Name of an existing WLAN to clone guest/portal settings from when creating a
# venue's WLAN. Leave unset to auto-pick the first portal-enabled WLAN.
# UNIFI_TEMPLATE_SSID=

# -----------------------------------------------------------------------------
# MCP server (container: mcp) — captive-server/mcp/
# -----------------------------------------------------------------------------
# Exposes HeidiFi captive-portal data to AI tools (Claude Code, Cursor) over the
# Model Context Protocol with Notion-style multi-tenant OAuth 2.1. Deployed as its
# own service at mcp.heidifi.ai:4001. See mcp/README / docs.
#
# Canonical MCP resource URI (RFC 8707 audience). No trailing slash.
MCP_SERVER_URL=https://mcp.heidifi.ai/mcp
# Authorization Server issuer origin (same as the resource server in v1).
MCP_ISSUER_URL=https://mcp.heidifi.ai
# Portal consent screen that /oauth/authorize redirects the user to.
OAUTH_CONSENT_URL=https://portal.heidifi.ai/captive-oauth/consent
# Token lifetimes.
OAUTH_CODE_TTL_SECONDS=120
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# The CMS, which owns the splash-config validator plus the template and media
# libraries. The splash tools (start_splash_setup, apply_splash_config, ...) call its
# /api/captive-portal/internal/* API; unset means those tools return 503.
CMS_BASE_URL=https://portal.heidifi.ai
# Guards the CMS's inbound internal routes; the same value must be set in the CMS.
# Generate a value DIFFERENT from MCP_INTERNAL_SECRET — the two guard opposite
# directions, so one shared secret means compromising either service grants both.
CMS_INTERNAL_SECRET=your_cms_internal_api_secret
# (Preview links come back from the CMS already built, using its
#  NEXT_PUBLIC_CAPTIVE_PORTAL_HOST — the portal host is not duplicated here.)

# DEV ONLY (never set in production): bypass OAuth with a static token bound to one tenant.
# MCP_DEV_STATIC_TOKEN=
# MCP_DEV_TENANT_ID=

